[Unit]
Description=HyprChat AI Platform
# Start after the network is up (and Tailscale, when HOST is a Tailscale address).
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=hyprchat
Group=hyprchat
WorkingDirectory=/opt/hyprchat/backend
EnvironmentFile=/opt/hyprchat/.env
ExecStart=/opt/hyprchat/venv/bin/python -m uvicorn main:app --host ${HOST} --port ${PORT} --workers 1 --timeout-graceful-shutdown 15
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/hyprchat/data

[Install]
WantedBy=multi-user.target
