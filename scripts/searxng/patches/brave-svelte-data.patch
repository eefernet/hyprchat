+def js_find_matching_bracket(text: str, start: int, open_char: str = "{", close_char: str = "}") -> int:
+    """Return index of the matching closing bracket, safely ignoring JS string literals."""
+    depth = 0
+    i = start
+    in_string = None
+    escape_ = False
+
+    while i < len(text):
+        c = text[i]
+        if in_string:
+            if escape_:
+                escape_ = False
+            elif c == "\\":
+                escape_ = True
+            elif c == in_string:
+                in_string = None
+        elif c in ('"', "'", "`"):
+            in_string = c
+        elif c == open_char:
+            depth += 1
+        elif c == close_char:
+            depth -= 1
+            if depth == 0:
+                return i
+        i += 1
+    raise ValueError(f"unbalanced {open_char}{close_char} starting at {start}")
+
+def js_split_args(args_str: str) -> list[str]:
+    """Split a JS argument list, respecting strings and nested brackets."""
+    args: list[str] = []
+    last_pos = 0
+    in_string = None
+    escape_ = False
+    depth = 0
+
+    for idx, c in enumerate(f"{args_str},"):
+        if in_string:
+            if escape_:
+                escape_ = False
+            elif c == "\\":
+                escape_ = True
+            elif c == in_string:
+                in_string = None
+        elif c in ('"', "'", "`"):
+            in_string = c
+        elif c in ("(", "[", "{"):
+            depth += 1
+        elif c in (")", "]", "}"):
+            depth -= 1
+        elif c == "," and depth == 0:
+            if item := args_str[last_pos:idx].strip():
+                args.append(item)
+            last_pos = idx + 1
+    return args
+
+def js_find_variable_positions(js_obj: str) -> list[tuple[str, int]]:
+    """Find all variables referenced in the JavaScript object."""
+    # pylint: disable=too-many-branches
+    # pylint: disable=unsubscriptable-object
+
+    matches: list[tuple[str, int]] = []
+
+    in_string = False
+    in_escape = False
+
+    # flat array like [1,2,3], not e.g. [{"a": 3}]
+    in_flat_array = False
+    # if the current position is inside the place of
+    # a JS value, e.g. the range of ` bar` in {"foo": bar}
+    in_value = False
+    current_var: tuple[str, int] | None = None
+
+    for pos, c in enumerate(js_obj):
+        if in_string:
+            if in_escape:
+                in_escape = False
+            elif c == "\\":
+                in_escape = True
+            elif c == in_string:
+                in_string = None
+        elif c in ("'", "\"", "`"):
+            in_string = c
+        elif c == ":":
+            in_value = True
+        elif c in (",", "{", "}", "[", "]"):
+            # handle matching variables in arrays like [a,b,c]
+            # i.e. if we encounter a "," in such a flat array,
+            # we're still inside a value
+            if c == "[":
+                in_flat_array = True
+            elif c != ",":
+                in_flat_array = False
+            in_value = in_flat_array
+            if current_var:
+                # reached end of variable name
+                if current_var[0] not in ("void0", "true", "false", "null", "undefined"):
+                    matches.append(current_var)
+                current_var = None
+        elif in_value:
+            if current_var and c in (string.ascii_letters + string.digits + "_$"):
+                current_var = (current_var[0] + c, current_var[1])
+            elif c in string.ascii_letters + "_$":
+                # start of new variable name
+                current_var = (c, pos)
+
+    return matches
+
+IIFE_RE = re.compile(
+    r"""
+    \(function\s*\(                    # (function(
+        (?P<params>[^)]*)              # formal parameters
+    \)\s*\{\s*return\s*                # ){ return
+        (?P<body>\{)                   # the object literal starts
+    """,
+    re.VERBOSE | re.DOTALL,
+)
+
+def extract_iife_object(data_src: str, match: re.Match[str]) -> tuple[str, int]:
+    """
+    Extract and substitute the object literal from a JavaScript IIFE.
+    Returns the transformed object literal and the position immediately after the IIFE call.
+    """
+    body_start = match.start("body")
+    body_end = js_find_matching_bracket(data_src, body_start, "{", "}")
+    obj_str = data_src[body_start : body_end + 1]
+
+    # 1. Locate the argument call execution signature block: ...)(arg1, arg2)
+    call_start = data_src.find("(", body_end)
+    if call_start == -1:
+        raise ValueError("IIFE missing call arguments")
+    call_end = js_find_matching_bracket(data_src, call_start, "(", ")")
+
+    # 2. map arguments
+    args = js_split_args(data_src[call_start + 1 : call_end])
+    params = [p.strip() for p in match["params"].split(",") if p.strip()]
+    mapping = dict(zip(params, args))
+
+    # 3. substitute idents
+    variables = js_find_variable_positions(obj_str)
+    for variable_name, pos in reversed(variables):
+        if variable_name in mapping:
+            value = mapping[variable_name]
+            obj_str = obj_str[:pos] + value + obj_str[pos + len(variable_name) :]
+
+    return obj_str, call_end + 1
