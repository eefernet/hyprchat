# HyprChat server settings: copy to /opt/hyprchat/.env and edit.
#
# systemd loads this file (EnvironmentFile=). Keep every comment on its own
# line: a "#" after a value is NOT a comment there, it becomes part of the
# value (for example QUICK_SEARCH_TIMEOUT=12 # seconds would stop the service
# from starting). Empty values mean "use the built-in default" or "feature off".

# ── Server ──
# 127.0.0.1 is only reachable from this machine. Use a private address (for
# example your Tailscale IP) to reach HyprChat from other devices.
HOST=127.0.0.1
PORT=8000
DEBUG=false

# CORS: comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Changes requested by another website through your browser are refused. Set off only behind a
# proxy that rewrites the Host header and makes every save fail with "came from another website".
HYPRCHAT_ORIGIN_CHECK=on

# TLS verification for outgoing HTTP. Set false ONLY for known self-signed internal services.
HTTP_VERIFY_SSL=true

# ── Local services (use addresses reachable from this server) ──
OLLAMA_URL=http://127.0.0.1:11434
# Hephaestus sandbox API (compatibility name).
CODEBOX_URL=http://127.0.0.1:8585
# Hephaestus engine worker.
OPENHANDS_URL=http://127.0.0.1:8587
# Daedalus coding jobs need this; there is no default. Usually the engine worker above.
# DAEDALUS_ENGINE_URL=http://127.0.0.1:8587
# The Hephaestus control token (documents, scoped execution, archive maintenance)
# is a secret: put it in /etc/hyprchat/hephaestus.env (mode 0600), which
# scripts/deploy.sh creates and the service loads, not in this file.
# HEPHAESTUS_TOKEN=
# Modern Hephaestus runtime URL, when it differs from CODEBOX_URL.
# HEPHAESTUS_MODERN_URL=
# 0 turns off the archive maintenance pass at startup.
# HEPHAESTUS_ARCHIVE_MAINTENANCE=1
SEARXNG_URL=http://127.0.0.1:8888
N8N_URL=http://127.0.0.1:5678
N8N_WEBHOOK_PATH=/webhook/execute-code

# ── Optional media services (empty = feature off) ──
COMFYUI_URL=
COMFYUI_WORKFLOW_PATH=
STT_URL=
STT_MODEL=Systran/faster-distil-whisper-large-v3
TTS_URL=
TTS_VOICE=af_heart

# ── Proxies ──
# Optional proxy for public page and image fetches. Leave empty unless the
# SearXNG privacy setup runs the host-local proxy on :8899.
HYPRCHAT_OUTBOUND_PROXY=
# Older names for the same proxy, still read:
# OUTBOUND_PROXY_URL=
# WEB_FETCH_PROXY_URL=
# A proxy that may also serve private-network previews (trusted hosts only).
# HYPRCHAT_TRUSTED_WEB_PROXY=
# Size cap for /api/proxy-preview, in bytes.
MAX_PROXY_PREVIEW_BYTES=12582912

# ── Storage ──
# Server-install paths. Local development can leave these out: the default is
# ./data in the checkout. To use HYPRCHAT_DATA_DIR as one base directory
# instead, remove the individual paths below (they take precedence).
# HYPRCHAT_DATA_DIR=/opt/hyprchat/data
DATABASE_PATH=/opt/hyprchat/data/hyprchat.db
UPLOAD_DIR=/opt/hyprchat/data/uploads
TOOLS_DIR=/opt/hyprchat/data/tools
KB_DIR=/opt/hyprchat/data/knowledge_bases
SANDBOX_DIR=/opt/hyprchat/data/sandbox
SETTINGS_PATH=/opt/hyprchat/data/settings.json
CONNECTOR_SECRETS_PATH=/opt/hyprchat/data/connector_secrets.json
MAX_UPLOAD_SIZE_MB=250

# ── Models ──
# Use models installed on your Ollama server. Most of these can be changed later in Settings.
DEFAULT_MODEL=qwen3.5:27b
WORKSPACE_MODEL=qwen3.5:4b
PLANNING_MODEL=qwen3.5:27b
CODER_MODEL=qwen2.5-coder:14b
EMBED_MODEL=nomic-embed-text
CRITIC_ENABLED=true

# ── Chat ──
# Context window for chats (tokens).
DEFAULT_NUM_CTX=16384
# Tool rounds one chat reply may use (Settings → Model & Generation).
MAX_AGENT_ROUNDS=40
# Summarize long chats as they fill: on or off, and when (85, 90, 95, 98 or 99 % of the window).
CONTEXT_COMPACTION=off
# CHAT_COMPACTION_PERCENT=85
# Keep what a reply's tools returned for later turns: on or off.
# CHAT_TOOL_MEMORY=on
# Tell the model when each message was written: on or off.
# CHAT_TIME_NOTES=on
# Reply models kept loaded in Ollama at once (0 = Ollama decides, 1-8).
# CHAT_MAX_LOADED_MODELS=0
# Cross-chat history recall: on or off.
HISTORY_RECALL=on

# ── Code execution ──
EXECUTION_TIMEOUT=60
SEARCH_RESULTS_COUNT=15
MAX_FETCH_CHARS=8000

# ── Quick Search ──
QUICK_SEARCH_MODE=balanced
# Seconds for the whole interactive search (speed, balanced and quality scale from it).
QUICK_SEARCH_TIMEOUT=12
# hybrid, or legacy (heuristic order only).
QUICK_SEARCH_RANKING=hybrid
QUICK_SEARCH_PROVIDER=searxng
QUICK_SEARCH_SCRAPER=local
# Embedding rerank: ollama (default) or none.
QUICK_SEARCH_RERANKER=ollama
QUICK_SEARCH_EMBED_RERANK=false
QUICK_SEARCH_EMBED_TIMEOUT=4.0
# llm, or deterministic to skip the parallel planner model.
QUICK_SEARCH_PLANNER=llm
QUICK_SEARCH_PLANNER_TIMEOUT=6.0
# Planner/refine model; empty = workspace model.
QUICK_SEARCH_TRIAGE_MODEL=
QUICK_SEARCH_MIN_RESULTS=10
QUICK_SEARCH_TARGET_RESULTS=24
QUICK_SEARCH_MAX_RESULTS=35
QUICK_SEARCH_PAGE_READS_BALANCED=8
# Comma-separated SearXNG engine lists; empty = SearXNG defaults.
QUICK_SEARCH_SEARXNG_ENGINES=
QUICK_SEARCH_SEARXNG_NEWS_ENGINES=
QUICK_SEARCH_SEARXNG_CODE_ENGINES=
QUICK_SEARCH_SEARXNG_RECIPE_ENGINES=
QUICK_SEARCH_SEARXNG_GAME_ENGINES=

# ── Knowledge bases ──
# none, or llm for Smart KB Reranking (local model, falls back on errors).
RAG_RERANKER=none
RAG_RERANK_TIMEOUT=8
# Hybrid retrieval budget per chat turn, in seconds.
RAG_RETRIEVAL_DEADLINE_SECONDS=3
# Scanned-PDF OCR fallback: on or off.
PDF_OCR=on
PDF_OCR_MAX_PAGES=50

# ── Research ──
RESEARCH_NUM_CTX=40960
# Optional tokens: CourtListener works anonymously too; GitHub raises API rate limits (GH_TOKEN is also read).
# COURTLISTENER_TOKEN=
# GITHUB_TOKEN=

# ── Chat image generation (runtime-editable in Settings) ──
IMAGE_CHAT_CHECKPOINT=
IMAGE_CHAT_WORKFLOW=
IMAGE_CHAT_RESOLUTION=1024x1024
IMAGE_CHAT_VAE=
IMAGE_CHAT_PROMPT_PREFIX=
IMAGE_CHAT_NEGATIVE=
IMAGE_CHAT_COMPOSE_MODEL=
IMAGE_CHAT_AUTO_ENHANCE=false

# ── Daedalus ──
OPENHANDS_NUM_CTX=65536
MAX_AGENT_ROUNDS_CODER=30
OPENHANDS_DISABLE_THINKING=true
# Agent model overrides. Empty: critic = PLANNING_MODEL, builder = CODER_MODEL,
# Q&A = the chat or persona model.
CRITIC_MODEL=
BUILDER_MODEL=
QA_MODEL=

# ── Scheduler (Jarvis) ──
SCHEDULER_TICK_SECONDS=30
SCHEDULED_RUN_TIMEOUT=900
SCHEDULER_FOREGROUND_DEFER_MIN=15
# Release qualification runs only: keeps the scheduler off.
# HYPRCHAT_DEPLOY_QUALIFICATION=1
