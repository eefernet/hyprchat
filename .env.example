# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# CORS — comma-separated origins; default to localhost frontends
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# HTTP client TLS verification (set to false ONLY for known self-signed internal services)
HTTP_VERIFY_SSL=true

# Local services — override with your homelab IPs locally
OLLAMA_URL=http://127.0.0.1:11434
CODEBOX_URL=http://127.0.0.1:8585
OPENHANDS_URL=http://127.0.0.1:8586
SEARXNG_URL=http://127.0.0.1:8888
N8N_URL=http://127.0.0.1:5678
N8N_WEBHOOK_PATH=/webhook/execute-code
N8N_RESEARCH_PATH=/webhook/deep-research

# Optional media services. Leave empty to disable that feature.
COMFYUI_URL=
COMFYUI_WORKFLOW_PATH=
STT_URL=
STT_MODEL=Systran/faster-distil-whisper-large-v3
TTS_URL=
TTS_VOICE=af_heart

# Optional proxy for public page/image fetches. Leave empty unless the
# SearXNG privacy setup activates the host-local proxy on :8899.
HYPRCHAT_OUTBOUND_PROXY=

# Storage. These are server-install defaults for /opt/hyprchat/.env.
# Local dev can omit these; backend/config.py defaults to repo-local ./data.
# To use HYPRCHAT_DATA_DIR as one custom base directory, remove/comment the
# specific path overrides below.
DATABASE_PATH=/opt/hyprchat/data/hyprchat.db
UPLOAD_DIR=/opt/hyprchat/data/uploads
TOOLS_DIR=/opt/hyprchat/data/tools
KB_DIR=/opt/hyprchat/data/knowledge_bases
SANDBOX_DIR=/opt/hyprchat/data/sandbox
SETTINGS_PATH=/opt/hyprchat/data/settings.json
CONNECTOR_SECRETS_PATH=/opt/hyprchat/data/connector_secrets.json
MAX_UPLOAD_SIZE_MB=50

# Execution
EXECUTION_TIMEOUT=60
SEARCH_RESULTS_COUNT=15
MAX_FETCH_CHARS=8000

# Quick Search
QUICK_SEARCH_MODE=balanced
QUICK_SEARCH_PROVIDER=searxng
QUICK_SEARCH_SCRAPER=local
QUICK_SEARCH_RERANKER=ollama  # embedding rerank is ON by default; set none to disable
QUICK_SEARCH_MIN_RESULTS=10
QUICK_SEARCH_TARGET_RESULTS=24
QUICK_SEARCH_MAX_RESULTS=35
QUICK_SEARCH_PAGE_READS_BALANCED=8
QUICK_SEARCH_SEARXNG_ENGINES=
QUICK_SEARCH_SEARXNG_NEWS_ENGINES=
QUICK_SEARCH_SEARXNG_CODE_ENGINES=
QUICK_SEARCH_SEARXNG_RECIPE_ENGINES=
QUICK_SEARCH_EMBED_RERANK=false
QUICK_SEARCH_EMBED_TIMEOUT=1.5
QUICK_SEARCH_TRIAGE_MODEL=

# Models
DEFAULT_MODEL=qwen3.5:27b
WORKSPACE_MODEL=qwen3.5:4b
PLANNING_MODEL=qwen3.5:27b
CODER_MODEL=qwen2.5-coder:14b
CRITIC_ENABLED=true

# Chat image generation defaults (runtime-editable in Settings)
IMAGE_CHAT_CHECKPOINT=
IMAGE_CHAT_WORKFLOW=
IMAGE_CHAT_RESOLUTION=1024x1024
IMAGE_CHAT_VAE=
IMAGE_CHAT_PROMPT_PREFIX=
IMAGE_CHAT_NEGATIVE=
IMAGE_CHAT_COMPOSE_MODEL=

# Agents
OPENHANDS_ENABLED=true
OPENHANDS_MAX_ROUNDS=20
OPENHANDS_NUM_CTX=16384
OPENHANDS_REASONING_EFFORT=medium
AIDER_ENABLED=true
AIDER_MODEL=
AIDER_NUM_CTX=16384
AIDER_AUTO_TEST=true
AIDER_WORKER_URL=http://127.0.0.1:8586
DEFAULT_NUM_CTX=16384
RESEARCH_NUM_CTX=40960
MAX_AGENT_ROUNDS=12
MAX_AGENT_ROUNDS_CODER=30

# ── Data & proxies ──
# HYPRCHAT_DATA_DIR=/opt/hyprchat/data   # default: <repo>/data
# OUTBOUND_PROXY_URL=                    # optional proxy for outbound web fetches
# WEB_FETCH_PROXY_URL=                   # legacy alias for OUTBOUND_PROXY_URL
MAX_PROXY_PREVIEW_BYTES=12582912         # /api/proxy-preview size cap

# ── RAG / documents ──
EMBED_MODEL=nomic-embed-text
RAG_RERANKER=none          # llm = Smart KB Reranking (local model, fail-open)
RAG_RERANK_TIMEOUT=8
PDF_OCR=on                 # scanned-PDF OCR fallback (needs rapidocr deps)
PDF_OCR_MAX_PAGES=50
HISTORY_RECALL=on          # cross-chat history search/injection
CONTEXT_COMPACTION=off     # auto-summarize long conversations

# ── Quick Search planner ──
QUICK_SEARCH_PLANNER=llm   # deterministic = skip the parallel LLM planner
QUICK_SEARCH_PLANNER_TIMEOUT=6.0
QUICK_SEARCH_SEARXNG_GAME_ENGINES=

# ── Jarvis scheduler ──
SCHEDULER_TICK_SECONDS=30
SCHEDULED_RUN_TIMEOUT=900
SCHEDULER_FOREGROUND_DEFER_MIN=15

# ── Images ──
IMAGE_CHAT_AUTO_ENHANCE=false

# ── Daedalus agent model overrides (empty = documented fallback) ──
ARCHITECT_MODEL=           # empty = PLANNING_MODEL
REVIEWER_MODEL=            # empty = PLANNING_MODEL
ACCEPTANCE_MODEL=          # empty = PLANNING_MODEL
CRITIC_MODEL=              # empty = PLANNING_MODEL
BUILDER_MODEL=             # empty = CODER_MODEL
FIXER_MODEL=               # empty = CODER_MODEL (also feeds Aider)
QA_MODEL=                  # empty = chat/persona model
AIDER_FOR_GREENFIELD=true
OPENHANDS_DISABLE_THINKING=true
MIN_NUM_CTX=1024
CODER_V2_MIN_NUM_CTX=32768
# AIDER_BIN=               # worker-side aider binary override (Codebox LXC)

# ── Optional API tokens ──
# COURTLISTENER_TOKEN=     # investigative research court adapter (anonymous works too)
# GITHUB_TOKEN=            # raises GitHub API rate limits for research fetches (GH_TOKEN also read)
